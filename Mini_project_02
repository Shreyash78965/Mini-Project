from collections import deque


def min_throws(jumps, size):
    visited = {1}
    queue = deque([(1, 0)])

    while queue:
        pos, throws = queue.popleft()
        if pos == size:
            return throws
        for dice in range(1, 7):
            nxt = pos + dice
            if nxt > size:
                continue
            nxt = jumps.get(nxt, nxt)
            if nxt not in visited:
                visited.add(nxt)
                queue.append((nxt, throws + 1))

    return -1


jumps = {
    3: 22, 5: 8, 11: 26, 20: 29,
    27: 1, 21: 9, 17: 4, 19: 7,
}

print(min_throws(jumps, 30))
