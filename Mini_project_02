from collections import deque


class Board:
    def __init__(self, size, jumps):
        self.size = size
        self.jumps = dict(jumps)
        self.validate()

    def validate(self):
        if self.size < 2:
            raise ValueError("board must have at least 2 squares")
        for start, end in self.jumps.items():
            if not (1 < start < self.size):
                raise ValueError(f"jump start {start} must be between 2 and {self.size - 1}")
            if not (1 <= end <= self.size):
                raise ValueError(f"jump end {end} is outside the board")
            if start == end:
                raise ValueError(f"jump {start} -> {end} does nothing")
        if self.size in self.jumps:
            raise ValueError("last square cannot have a snake or ladder")

    def kind(self, square):
        if square not in self.jumps:
            return None
        return "ladder" if self.jumps[square] > square else "snake"

    def land(self, square):
        return self.jumps.get(square, square)

    def ladders(self):
        return {s: e for s, e in self.jumps.items() if e > s}

    def snakes(self):
        return {s: e for s, e in self.jumps.items() if e < s}

    def describe(self):
        print(f"Board size : {self.size}")
        print("Ladders    :", ", ".join(f"{s}->{e}" for s, e in sorted(self.ladders().items())) or "none")
        print("Snakes     :", ", ".join(f"{s}->{e}" for s, e in sorted(self.snakes().items())) or "none")

    def draw(self, columns=10):
        rows = (self.size + columns - 1) // columns
        for r in range(rows - 1, -1, -1):
            squares = list(range(r * columns + 1, min((r + 1) * columns, self.size) + 1))
            if r % 2 == 1:
                squares.reverse()
            cells = []
            for n in squares:
                mark = {"ladder": "L", "snake": "S"}.get(self.kind(n), " ")
                cells.append(f"{n:>3}{mark}")
            print(" ".join(cells))


def min_throws(board, dice_faces=6):
    start, goal = 1, board.size
    throws = {start: 0}
    parent = {start: None}
    queue = deque([start])

    while queue:
        pos = queue.popleft()
        if pos == goal:
            break
        for dice in range(1, dice_faces + 1):
            landed = pos + dice
            if landed > goal:
                continue
            nxt = board.land(landed)
            if nxt not in throws:
                throws[nxt] = throws[pos] + 1
                parent[nxt] = (pos, dice, landed)
                queue.append(nxt)

    if goal not in throws:
        return -1, []

    moves = []
    square = goal
    while parent[square] is not None:
        prev, dice, landed = parent[square]
        moves.append((prev, dice, landed, square))
        square = prev
    moves.reverse()
    return throws[goal], moves


def explore_levels(board, dice_faces=6):
    seen = {1}
    levels = [[1]]
    while levels[-1]:
        nxt_level = []
        for pos in levels[-1]:
            for dice in range(1, dice_faces + 1):
                landed = pos + dice
                if landed > board.size:
                    continue
                nxt = board.land(landed)
                if nxt not in seen:
                    seen.add(nxt)
                    nxt_level.append(nxt)
        levels.append(sorted(nxt_level))
    return levels[:-1]


def print_route(board, throws, moves):
    if throws == -1:
        print("Result     : last square cannot be reached (-1)")
        return
    print(f"Result     : minimum throws = {throws}")
    for i, (prev, dice, landed, final) in enumerate(moves, 1):
        note = ""
        if final != landed:
            note = f"  ({board.kind(landed)} {landed} -> {final})"
        print(f"  Throw {i}: square {prev:>2} + dice {dice} = {landed:>2}{note}")


def run_case(title, board):
    print(f"--- {title} ---")
    board.describe()
    throws, moves = min_throws(board)
    print_route(board, throws, moves)
    print()
    return throws


def main():
    sample = Board(30, {3: 22, 5: 8, 11: 26, 20: 29, 27: 1, 21: 9, 17: 4, 19: 7})
    print("Sample board (L = ladder start, S = snake start):")
    sample.draw(columns=6)
    print()
    run_case("Case 1: sample board", sample)

    print("Squares reached at each level (throw count):")
    for level, squares in enumerate(explore_levels(sample)):
        print(f"  {level}: {squares}")
    print()

    run_case("Case 2: no snakes or ladders", Board(30, {}))

    classic = Board(100, {
        2: 38, 7: 14, 8: 31, 15: 26, 21: 42, 28: 84, 36: 44, 51: 67, 71: 91, 78: 98, 87: 94,
        16: 6, 46: 25, 49: 11, 62: 19, 64: 60, 74: 53, 89: 68, 92: 88, 95: 75, 99: 80,
    })
    run_case("Case 3: classic 100 square board", classic)

    blocked = Board(30, {s: 1 for s in range(2, 8)})
    run_case("Case 4: unreachable last square", blocked)

    print("--- Case 5: invalid boards ---")
    for size, jumps in [(30, {30: 5}), (30, {40: 2}), (30, {5: 5}), (1, {})]:
        try:
            Board(size, jumps)
        except ValueError as error:
            print(f"Rejected   : size={size}, jumps={jumps} -> {error}")


if __name__ == "__main__":
    main()
